{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart Bulk File Renamer",
  "version": "1.0.0",
  "identifier": "com.renamee.smartbulkfilerenamer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Smart Bulk File Renamer",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Renamee Desktop Tools",
    "shortDescription": "Offline Smart Bulk TV Episode & Media File Renamer for Windows",
    "category": "Utility",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
